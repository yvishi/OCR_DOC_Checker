# Copy to .env and fill in. Never commit .env.

# LLM via OpenRouter: key from https://openrouter.ai/keys, model id from https://openrouter.ai/models
# (pick one that accepts image input, for the vision fallback)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=

# Full path to tesseract.exe if it is not on PATH
TESSERACT_CMD=

# Origin of the UI page allowed by CORS
CORS_ORIGIN=
